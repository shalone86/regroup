{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "regroup",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ai": { "binding": "AI" },
  "observability": { "enabled": true },
  // Lives at angelio.org through the hub. The old address redirects there with saved progress (worker/moved.js).
  "vars": { "HOME_URL": "https://angelio.org/regroup/", "STORE_KEY": "regroup:v1" },
  "workers_dev": true,
  // Custom domain (same pattern as articulate.shalonely.com / hablar.shalonely.com):
  "routes": [{ "pattern": "regroup.shalonely.com", "custom_domain": true }]
  //
  // Optional: require a passcode for the voice API (keeps strangers off your Workers AI quota):
  //   npx wrangler secret put APP_PASSCODE
}
